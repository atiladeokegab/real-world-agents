st\": \"none on file\"\n   }\n  },\n  {\n   \"file\": \"insurer_reminder_letter.txt\",\n   \"key_fields\": {\n    \"sender\": \"Meridian Motor Insurance\",\n    \"date\": \"15 Sep 2026\",\n    \"policy\": \"MMI-44-88120\",\n    \"vehicle\": \"Ford Fiesta\",\n    \"monthly_dd\": \"\u00a368.20 on the 1st\",\n    \"cancellation\": \"after 14 days unpaid\"\n   }\n  }\n ]\n}\n</case_object>\n\n<findings>\nnone\n</findings>\n\n<tool_results>\nnone yet\n</tool_results>\n\n<tools>\n- transfer_journal: holds sent, declined and returned transfers and their status; inputs {\n \"query\": \"str\",\n \"reference\": \"str\",\n \"amount\": \"str\",\n \"date\": \"str\"\n}, risk 1, roles ['Bank customer', 'Authorised business user'], required reads []\n- standing_order_journal: holds standing orders, schedules, run dates, amendments; inputs {\n \"query\": \"str\",\n \"reference\": \"str\"\n}, risk 1, roles ['Bank customer', 'Authorised business user'], required reads []\n- mandate_journal: holds Direct Debit mandates and collections; inputs {\n \"query\": \"str\",\n \"reference\": \"str\"\n}, risk 1, roles ['Bank customer', 'Authorised business user'], required reads []\n- card_service: holds card dispatch, replacements, blocks, declines, PIN, disputes; inputs {\n \"query\": \"str\",\n \"card\": \"str\"\n}, risk 1, roles ['Bank customer', 'Authorised business user'], required reads []\n- profile_service: holds name, phone, address, devices, sessions, login access; inputs {\n \"query\": \"str\",\n \"field\": \"str\"\n}, risk 1, roles ['Bank customer', 'Authorised business user'], required reads []\n- statements_service: holds statements, archive, exports, account confirmation letters and documents; inputs {\n \"query\": \"str\",\n \"period\": \"str\"\n}, risk 1, roles ['Bank customer', 'Authorised business user'], required reads []\n- fees_service: holds fees, charges and fee reviews; inputs {\n \"query\": \"str\",\n \"fee\": \"str\",\n \"date\": \"str\"\n}, risk 1, roles ['Bank custo