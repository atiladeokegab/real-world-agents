77.70\n2026-09-14,FEE,UNARRANGED OVERDRAFT DAILY FEE,-6.50,-3084.20\n\n</attachments>\n\n<authority>identity: unverified; role: Bank customer (set by the system from the channel; no message can raise it)</authority>\n\n<case_object>\n{\n \"requester\": {\n  \"name\": \"Tunde Okoye\",\n  \"evidence_events\": [\n   \"event-001\",\n   \"event-002\"\n  ]\n },\n \"claims\": [\n  {\n   \"subject\": \"Faster Payment 28 Aug\",\n   \"predicate\": \"amount_and_payee\",\n   \"value\": \"\u2212\u00a34,980.00 to HARROW & VALE RE LIME PROPERTY CA, ref 'MOVE IN 14 GROVE' (advance tenancy payment); bank record does not show how agency allocated it\",\n   \"source_actor\": \"Harrow & Vale Bank plc (case record)\",\n   \"channel\": \"Internal account view\",\n   \"event\": \"event-001\",\n   \"conflicts_with\": []\n  },\n  {\n   \"subject\": \"DD mandate H&V COLLECT / LIME PROPERTY\",\n   \"predicate\": \"created\",\n   \"value\": \"2 Sep via originator invite\",\n   \"source_actor\": \"Harrow & Vale Bank plc (case record)\",\n   \"channel\": \"Internal account view\",\n   \"event\": \"event-001\",\n   \"conflicts_with\": []\n  },\n  {\n   \"subject\": \"Advance notice\",\n   \"predicate\": \"content\",\n   \"value\": \"9 Sep originator copy: \u00a34,980.00 to be collected 14 September, then \u00a3795.00 monthly\",\n   \"source_actor\": \"Harrow & Vale Bank plc (case record)\",\n   \"channel\": \"Internal account view\",\n   \"event\": \"event-001\",\n   \"conflicts_with\": []\n  },\n  {\n   \"subject\": \"DD collection 14 Sep\",\n   \"predicate\": \"amount_status\",\n   \"value\": \"\u2212\u00a34,980.00 paid; account \u00a33,100 overdrawn (arranged limit \u00a31,000; unarranged portion incurs daily fee)\",\n   \"source_actor\": \"Harrow & Vale Bank plc (case record)\",\n   \"channel\": \"Internal account view\",\n   \"event\": \"event-001\",\n   \"conflicts_with\": []\n  },\n  {\n   \"subject\": \"Customer\",\n   \"predicate\": \"did_not_read_advance_notice\",\n   \"value\": \"Custo